# --- Auth: pick ONE ---------------------------------------------------------
# Option A (recommended): use your Claude Pro/Max subscription.
# Run `claude setup-token` (needs Claude Code installed + logged in) and paste
# the resulting sk-ant-oat01-... token here. Valid ~1 year.
CLAUDE_CODE_OAUTH_TOKEN=

# Option B: pay-as-you-go API key from console.anthropic.com.
# NOTE: if this is set it takes precedence over CLAUDE_CODE_OAUTH_TOKEN.
# ANTHROPIC_API_KEY=

# --- Clone config -----------------------------------------------------------
# The repo you want Andrew to work in.
ANDREW_WORKDIR=
# Model: "sonnet" (default, cheaper) or "opus" (harder work).
# ANDREW_MODEL=sonnet
