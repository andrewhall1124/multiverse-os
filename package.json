{
  "name": "multiverse-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small team of coding variants built on the Claude Agent SDK.",
  "scripts": {
    "chat": "bun run src/main.ts chat",
    "dev": "bun --watch src/main.ts chat",
    "web": "bun run src/main.ts web",
    "web:dev": "bun --watch src/main.ts web",
    "lint": "biome check src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^25.9.1",
    "typescript": "^5.6.0"
  }
}
