{
  "name": "muppet-andrew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A single coding variant ('Muppet Andrew') built on the Claude Agent SDK harness.",
  "scripts": {
    "chat": "bun run src/chat.ts",
    "dev": "bun --watch src/chat.ts",
    "web": "bun run src/server.ts",
    "web:dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^25.9.1",
    "typescript": "^5.6.0"
  }
}
